# Supabase Configuration (Update these with your project values)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URL (used for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Feature flag: set to "true" to show the "Continue with Google" button on /auth.
# Defaults to hidden so a missing or disabled Google OAuth client does not surface
# a broken sign-in option to customers. Enable once the Google Cloud project AND
# Supabase Auth → Providers → Google are both wired up.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Resend Configuration (for emails)
RESEND_API_KEY=
RESEND_DOMAIN=resend.dev

# Sendcloud v3 (shipping label generation via EVRI)
# Sign up at sendcloud.com — no direct EVRI account needed.
# API keys: Settings → Integrations → Sendcloud API → create integration
SENDCLOUD_API_KEY=
SENDCLOUD_API_SECRET=

# Shipping option code + contract ID:
# Sendcloud dashboard → Shipping → Shipping Methods → click EVRI Tracked → note:
#   - "code" (e.g. evri:tracked48, evri_uk:next_day_dropoff)
#   - the contract ID (integer) for your enabled EVRI contract
SENDCLOUD_SHIPPING_OPTION_CODE=
SENDCLOUD_CONTRACT_ID=

# Sender (warehouse) address — printed on every label as the return address
SENDER_NAME=
SENDER_ADDRESS_LINE_1=
SENDER_ADDRESS_LINE_2=
SENDER_POSTCODE=
SENDER_CITY=
SENDER_COUNTRY=GB
SENDER_PHONE=
